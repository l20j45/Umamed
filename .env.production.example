###############################################################################
# Umamed — configuración de PRODUCCIÓN
#
# Copia este archivo como .env en el servidor (nunca lo subas al repositorio):
#   cp .env.production.example .env
#   php artisan key:generate
#
# Diferencias importantes con el .env de desarrollo:
#   - APP_ENV=production y APP_DEBUG=false: si DEBUG queda en true, cualquier
#     error muestra trazas con credenciales y rutas del servidor.
#   - APP_URL debe ser la URL real con https: se usa en correos y en los
#     enlaces de WhatsApp.
#   - La cookie de sesión se marca Secure (sólo viaja por https).
###############################################################################

APP_NAME=Umamed
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=https://umamed.ejemplo.com

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_MX

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

# En producción conviene "daily" para no crecer un solo archivo sin límite.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

# Base de datos: SQLite (archivo dentro de storage/app, cubierto por el volumen)
DB_CONNECTION=sqlite
# DB_DATABASE=/var/www/html/storage/app/umamed.sqlite
# MySQL (opcional, en lugar de SQLite):
# DB_CONNECTION=mysql
# DB_HOST=mysql
# DB_PORT=3306
# DB_DATABASE=Umamed
# DB_USERNAME=umamed
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

# Correo transaccional (credenciales de pacientes y resumen diario).
# Puerto 587 → MAIL_SCHEME=smtp (STARTTLS) · Puerto 465 → MAIL_SCHEME=smtps
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp.ejemplo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@ejemplo.com"
MAIL_FROM_NAME="${APP_NAME}"

# WhatsApp (ver README: plantilla aprobada obligatoria para recordatorios)
WHATSAPP_DRIVER=log
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_PLANTILLA=
WHATSAPP_PLANTILLA_IDIOMA=es_MX
WHATSAPP_PAIS=52
WHATSAPP_HORAS_ANTES=24
WHATSAPP_RECORDATORIOS=false

# Clínica
CLINIC_TIMEZONE=America/Mexico_City
CLINIC_HORA_RESUMEN=07:00
CLINIC_FOTO_LADO_MAXIMO=1600
CLINIC_FOTO_CALIDAD_JPEG=85

VITE_APP_NAME="${APP_NAME}"
