###############################################################################
# Umamed · .env para el Raspberry Pi (docker compose)
#
# Coloca este archivo JUNTO a docker-compose.yml como ".env": compose lo pasa
# al contenedor con env_file (no hace falta más configuración).
#
#   cp .env.raspberry.example .env
#   nano .env          # llena los campos señalados con [LLENAR]
#
# Después: docker compose up -d y, si es el primer arranque:
#   docker compose exec umamed php artisan migrate --seed --force
#   docker compose restart
###############################################################################

APP_NAME=Umamed
APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_LOCALE=es

# ── [LLENAR] Llave de la app (32 bytes base64). Genera una SIN artisan desde
#    la terminal del Pi:
#      echo "base64:$(head -c 16 /dev/urandom | base64)"
#    NO la cambies después: invalida las sesiones y los datos encriptados.
APP_KEY=

# ── [LLENAR] La URL pública de la app, con PUERTO si no es el 80/443:
#    http://umamed.local:6000 · http://192.168.1.24:6000 por LAN, o
#    https://app.tudominio.mx si pasa por Cloudflare Tunnel.
#    Se usa en correos, redirects y cookies; si la cambias, re-loguea.
APP_URL=http://umamed.local:6000
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_MX
APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

# ── Base de datos: SQLite dentro del volumen storage_dataUmamed.
#    DB_DATABASE es OBLIGATORIO y relativo: /var/www/html/storage/app está
#    mapeado al volumen; dejarlo en comentario manda la base a database/
#    (fuera del volumen) y se pierde al reconstruir el contenedor.
DB_CONNECTION=sqlite
DB_DATABASE=storage/app/umamed.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
# false mientras entres por http local. CON CLOUDFLARE TUNNEL (u otro https
# real) ponla en true: el navegador recibe la app por TLS y la cookie no
# debe viajar en claro. No confundir con SESSION_ENCRYPT: con
# SESSION_DRIVER=database la sesión vive servidor-side (en la base) y el
# cookie sólo lleva el ID, así que SESSION_ENCRYPT=false sigue siendo lo
# correcto igual detrás del túnel.
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database
CACHE_PREFIX=

# ── [LLENAR] Correo transaccional (avisos, resumen diario). Sin SMTP válido
#    déjalo en "log": los mensajes terminan en /var/log/storage/logs.
MAIL_MAILER=smtp
MAIL_SCHEME=smtp          # puerto 587 → smtp (STARTTLS) · 465 → smtps
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Umamed

# ── WhatsApp oficial (opcional; el botón wa.me funciona sin esto).
WHATSAPP_DRIVER=log
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_PLANTILLA=
WHATSAPP_PLANTILLA_IDIOMA=es_MX
WHATSAPP_PAIS=52
WHATSAPP_HORAS_ANTES=24
WHATSAPP_RECORDATORIOS=false

# ── Notificaciones push (Web Push). Copia aquí las llaves VAPID que genera
#    con `php artisan webpush:vapid` en tu máquina de desarrollo (NO las
#    regeneres: cada rotación invalida las suscripciones del teléfono).
PUSH_RECORDATORIOS=true
VAPID_SUBJECT=mailto:avisos@ejemplo.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ── Clínica
CLINIC_TIMEZONE=America/Mexico_City
CLINIC_HORA_RESUMEN=07:00
CLINIC_FOTO_LADO_MAXIMO=1600
CLINIC_FOTO_CALIDAD_JPEG=85

VITE_APP_NAME=Umamed
